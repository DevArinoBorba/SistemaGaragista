# Set private values in the ignored .env.local, never NEXT_PUBLIC_*.
DATABASE_URL=
# Optional direct connection for migration providers that require it.
DATABASE_URL_UNPOOLED=
LOG_LEVEL=info
# Generate a private random secret with at least 32 characters.
BETTER_AUTH_SECRET=
# Local launchers align this to their selected port; set HTTPS origin on production.
BETTER_AUTH_URL=
