{
  "name": "garagista",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "powershell -NoProfile -File scripts/start-local.ps1 -Mode dev",
    "build": "next build",
    "start": "powershell -NoProfile -File scripts/start-local.ps1 -Mode start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "lint:rules": "node scripts/verify-quality-rules.mjs ./eslint-rules/index.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "pnpm lint && pnpm typecheck && pnpm lint:rules && pnpm test && pnpm build",
    "db:local": "node scripts/local-db.mjs",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "admin:rotate": "tsx --conditions=react-server scripts/create-admin.ts --rotate",
    "backup:local": "tsx --conditions=react-server scripts/backup-local.ts",
    "backup:restore": "tsx --conditions=react-server scripts/backup-local.ts --restore",
    "db:doctor": "tsx --conditions=react-server scripts/db-doctor.ts",
    "vehicles:import-csv": "tsx --conditions=react-server scripts/import-csv.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.10",
    "better-auth": "1.7.10",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-drizzle": "^0.2.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  }
}
